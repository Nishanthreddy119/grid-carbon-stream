# Copy to .env and fill in. Never commit .env.
EIA_API_KEY=your_key_here

# Kafka / Redpanda
KAFKA_BOOTSTRAP=localhost:19092

# Grid regions (EIA balancing-authority codes), comma separated.
# ERCO=ERCOT (Texas), PJM=PJM (incl. Chicago/ComEd), MISO=Midcontinent, CISO=California ISO,
# NYIS=New York ISO, ISNE=ISO New England, SWPP=Southwest Power Pool
REGIONS=ERCO,PJM,MISO,CISO,NYIS

# How many hours back each poll requests (EIA data arrives with a lag and gets revised)
LOOKBACK_HOURS=48
# Seconds between polls (EIA updates hourly; polling every 15 min is plenty)
POLL_SECONDS=900

DUCKDB_PATH=data/grid.duckdb
